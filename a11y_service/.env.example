# LLM: any OpenAI-compatible endpoint. Defaults target Groq.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Retrieval models (run locally via sentence-transformers; Groq has no embeddings API)
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Set false to run BM25-only (no model downloads)
RETRIEVAL_ENABLED=true

# Qdrant: leave empty for embedded local mode, or e.g. http://localhost:6333 (Docker)
QDRANT_URL=

MAX_PAYLOAD_BYTES=2097152
